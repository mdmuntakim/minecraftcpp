<?xml version="1.0" encoding="utf-8"?>
<!-- MinecraftC++ is a clean-room C++ voxel engine. The package name is the
     one requested in the issue; the app ships no Mojang code or assets. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tw.jjala.minecraftc"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hasCode="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="MinecraftC++"
        android:theme="@style/AppTheme">

        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <meta-data
                android:name="android.app.lib_name"
                android:value="minecraftcpp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
